# -----------------------------------------------------------------------------
# Environment template — copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is git-ignored; never commit real secrets.
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# Local SQLite (default for development). Use an absolute path or file:./db/...
DATABASE_URL="file:./db/custom.db"

# --- Site --------------------------------------------------------------------
# Production: https://migunani-pool.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Migunani"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# --- Supabase (optional; auth, dashboard & history features) -----------------
# Leave empty to run in guest-only mode — all tools still work.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Analytics (all optional) ------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
NEXT_PUBLIC_VERCEL_WEB_VITALS_DSN=""
# "granted" | "denied"
NEXT_PUBLIC_ANALYTICS_CONSENT_DEFAULT="denied"

# --- Monitoring (optional) ---------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_ENABLE_SOURCE_MAPS="false"

# --- Ads (optional) ----------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=""
